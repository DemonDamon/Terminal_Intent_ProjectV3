# ======================================================
# 环境变量模板
# 复制此文件为 .env 并修改配置
# cp .env.example .env
# ======================================================
#
# 重要提示:
# 1. 不要在值两端加引号 (正确: API_KEY=abc123, 错误: API_KEY="abc123")
# 2. 不要在等号两边加空格 (正确: API_KEY=abc123, 错误: API_KEY = abc123)
# 3. 如果从Windows复制文件，请转换为Unix换行符: sed -i 's/\r$//' .env
# ======================================================

# ============== 认证配置 ==============
# API密钥 (生产环境必须修改!)
# 生成方式: python generate_api_key.py --update
API_KEY=IYAPf1zC9QFoRcSXpz0zZBK21TmkGwagoa5sDzpW9CPCrtJ0

# ============== 服务配置 ==============
# 主机地址
HOST=0.0.0.0

# 服务端口
PORT=8000

# Docker映射端口 (宿主机端口)
HOST_PORT=8000

# 工作进程数 (建议设置为CPU核心数)
WORKERS=1

# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============== 模型配置 ==============
# 以下路径在Docker容器内使用，一般无需修改
# MODEL_PATH=/app/models/intent_v2.pkl
# FEATURE_NAMES_PATH=/app/models/feature_names.pkl
# THRESHOLD_PATH=/app/models/optimal_threshold.pkl

# ============== 生产环境建议 ==============
# 生产环境示例:
# API_KEY=your-secure-random-key-at-least-32-chars
# WORKERS=4
# LOG_LEVEL=WARNING
